{
  "schemaVersion": 1,
  "id": "wechat",
  "background": {
    "type": "gradient_v",
    "colors": ["#151515", "#3F3F3F"],
    "stops": [0.0, 0.22]
  },
  "avatar": {
    "shape": "ROUNDED_SQUARE",
    "sizeDp": 78,
    "verticalBias": 0.31,
    "placeholder": {
      "type": "SOLID_BLOCK",
      "bgColor": "#FFFFFFFF",
      "fgColor": "#FFFFFFFF",
      "fontSizeRatio": 0.45
    }
  },
  "callerName": {
    "text": "@caller_name",
    "color": "#FFFFFFFF",
    "sizeSp": 24,
    "weight": "REGULAR"
  },
  "callerInfo": {
    "position": "BELOW_AVATAR",
    "verticalBias": 0.64,
    "primary": {
      "text": "@theme_wechat_subtitle_invite",
      "color": "#888888",
      "sizeSp": 14,
      "weight": "REGULAR"
    }
  },
  "buttons": {
    "layout": "HORIZONTAL_PAIR",
    "gapDp": 94,
    "verticalBiasFromBottom": 0.16,
    "reject": {
      "shape": "CIRCLE",
      "sizeDp": 56,
      "backgroundColor": "#FC4F51",
      "iconAsset": "themes/whatsapp/ic_reject.svg",
      "iconColor": "#FFFFFFFF",
      "labelText": "@theme_btn_decline",
      "animation": "NONE",
      "gesture": "TAP"
    },
    "accept": {
      "shape": "CIRCLE",
      "sizeDp": 56,
      "backgroundColor": "#15C064",
      "iconAsset": "themes/whatsapp/ic_accept.svg",
      "iconColor": "#FFFFFFFF",
      "labelText": "@theme_btn_accept",
      "animation": "NONE",
      "gesture": "TAP"
    }
  },
  "connectedBgColor": "#0F0F0E"
}
