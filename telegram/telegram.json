{
  "schemaVersion": 1,
  "id": "telegram",
  "background": {
    "type": "gradient_v",
    "colors": ["#1C2731", "#2AABEE", "#5B9BD5"]
  },
  "topLabel": {
    "text": "Telegram audio call",
    "color": "#FFFFFFA8",
    "sizeSp": 14,
    "weight": "REGULAR"
  },
  "brandGlyph": {
    "assetPath": "themes/telegram/glyph.svg",
    "sizeDp": 16
  },
  "avatar": {
    "shape": "CIRCLE",
    "sizeDp": 160,
    "verticalBias": 0.30
  },
  "callerName": {
    "text": "@caller_name",
    "color": "#FFFFFF",
    "sizeSp": 32,
    "weight": "LIGHT"
  },
  "statusText": {
    "text": "@theme_subtitle_encrypted",
    "color": "#FFFFFF80",
    "sizeSp": 12,
    "weight": "REGULAR"
  },
  "buttons": {
    "layout": "HORIZONTAL_PAIR",
    "gapDp": 56,
    "verticalBiasFromBottom": 0.18,
    "accept": {
      "shape": "CIRCLE",
      "sizeDp": 64,
      "backgroundColor": "#FFFFFF1F",
      "iconAsset": "themes/_shared/ic_phone_accept.svg",
      "iconColor": "#FFFFFFCC",
      "animation": "PULSE"
    },
    "reject": {
      "shape": "CIRCLE",
      "sizeDp": 64,
      "backgroundColor": "#FFFFFF1F",
      "iconAsset": "themes/_shared/ic_phone_reject.svg",
      "iconColor": "#FFFFFFCC",
      "animation": "NONE"
    }
  },
  "connectedBgColor": "#1C2731"
}
