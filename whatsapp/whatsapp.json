{
  "schemaVersion": 1,
  "id": "whatsapp",
  "background": {
    "type": "patterned_solid",
    "color": "#0F1217",
    "patternAsset": "themes/whatsapp/doodle.png",
    "patternOpacity": 0.13,
    "patternTint": null
  },
  "brandGlyph": {
    "assetPath": "themes/whatsapp/glyph.svg",
    "sizeDp": 14
  },
  "avatar": {
    "shape": "CIRCLE",
    "sizeDp": 190,
    "verticalBias": 0.47,
    "placeholder": {
      "type": "INITIAL_LETTER",
      "bgColor": "#DDEEFF",
      "fgColor": "#2761C5",
      "fontSizeRatio": 0.41
    }
  },
  "callerName": {
    "text": "@caller_name",
    "color": "#00000000",
    "sizeSp": 1,
    "weight": "REGULAR"
  },
  "callerInfo": {
    "position": "TOP",
    "verticalBias": 0.12,
    "primary": {
      "text": "@caller_number",
      "color": "#FFFFFFFF",
      "sizeSp": 30,
      "weight": "BOLD"
    },
    "secondary": {
      "prefixGlyph": {
        "assetPath": "themes/whatsapp/glyph.svg",
        "sizeDp": 14
      },
      "parts": ["~ ", "@caller_name"],
      "color": "#B0FFFFFF",
      "sizeSp": 14,
      "weight": "REGULAR"
    }
  },
  "buttons": {
    "layout": "HORIZONTAL_TRIPLE",
    "gapDp": 24,
    "verticalBiasFromBottom": 0.10,
    "gestureHint": {
      "type": "SWIPE_UP_CHEVRONS",
      "color": "#80FFFFFF",
      "targetButton": "ACCEPT",
      "verticalOffsetDp": 12,
      "animation": "SLIDE_UP_FADE",
      "animationDurationMs": 1400
    },
    "reject": {
      "shape": "CIRCLE",
      "sizeDp": 64,
      "backgroundColor": "#D72E41",
      "iconAsset": "themes/whatsapp/ic_reject.svg",
      "iconColor": "#FFFFFFFF",
      "labelText": "@theme_btn_decline",
      "animation": "NONE",
      "gesture": "TAP"
    },
    "accept": {
      "shape": "CIRCLE",
      "sizeDp": 64,
      "backgroundColor": "#52A66A",
      "iconAsset": "themes/whatsapp/ic_accept.svg",
      "iconColor": "#FFFFFFFF",
      "labelText": "@theme_btn_swipe_up_to_accept",
      "animation": "PULSE",
      "gesture": "SWIPE_UP",
      "swipeThresholdDp": 80
    },
    "tertiary": {
      "shape": "CIRCLE",
      "sizeDp": 64,
      "backgroundColor": "#2D2D2D",
      "iconAsset": "themes/whatsapp/ic_message.svg",
      "iconColor": "#FFFFFFFF",
      "labelText": "@theme_btn_message",
      "animation": "NONE",
      "gesture": "TAP"
    }
  },
  "connectedBgColor": "#0F1217"
}
